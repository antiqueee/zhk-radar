DATABASE_URL=postgresql+asyncpg://radar:local-development-only@localhost:5432/radar
POSTGRES_PASSWORD=local-development-only
OPENROUTER_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
TG_BOT_TOKEN=
TG_GROUP_ID=
TG_OPERATOR_ID=
TG_API_ID=
TG_API_HASH=
TG_SESSION_KEY=
AUTHOR_HASH_SALT=
GOOGLE_SA_JSON=
SHEET_ID=
RU_PROXY_URL=

# Optional same-query search comparison
PERPLEXITY_API_KEY=
BRAVE_SEARCH_API_KEY=
# TG_SESSION is generated by the local Telegram sign-in form; never commit it.

# Optional server mode; create users with radar user-add (do not put passwords here).
RADAR_SERVER_MODE=false
RADAR_PUBLIC_ORIGIN=
# Docker Compose domain (without https://)
RADAR_DOMAIN=
# RADAR_USERS is written by the CLI; GOOGLE_SA_CREDENTIALS by Connections upload.

# Optional public-source adapters
VK_SERVICE_TOKEN=
HH_USER_AGENT=
# Optional weekly email (implicit TLS, port 465)
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Optional client-encrypted backups to AWS S3 (all delivery flags default off)
BACKUP_REGION=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
